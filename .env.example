# Plausible Analytics（本番のみ設定推奨）
# https://plausible.io — サイトに chord-palette.vercel.app を登録後、ドメイン名を入れる
VITE_PLAUSIBLE_DOMAIN=

# Phase 2 軽量マネタイズ（任意）
VITE_KOFI_URL=
VITE_WAITLIST_URL=

# TheoryExplainer API（任意）
VITE_ENABLE_EXPLAIN=false

# ============================================================
# Sprint 16: Pro 機能（MIDI エクスポート） — Stripe + HMAC ライセンス
# ============================================================

# === サーバー専用（Vercel Function 内のみ参照、クライアントに露出禁止）===
# 重要: 下記 3 つには絶対に VITE_ プレフィクスを付けないこと
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
LICENSE_SECRET=

# Stripe Product ID（任意・誤決済防止用、設定しなければ商品チェックをスキップ）
STRIPE_PRODUCT_ID_PRO=prod_...

# Stripe API バージョン（任意、未指定なら SDK デフォルト）
STRIPE_API_VERSION=2025-04-30.basil

# === クライアントに露出 OK（VITE_ プレフィクス）===
# Stripe Payment Link の URL
VITE_STRIPE_PAYMENT_URL=https://buy.stripe.com/test_xxx
#
# Payment Link「支払い後」のリダイレクト先（Stripe ダッシュボードに貼る）:
#   本番: https://chord-palette.vercel.app/pro/success?session_id={CHECKOUT_SESSION_ID}
#   詳細: docs/stripe-payment-link-setup.md
# UI 表示用価格文字列
VITE_PRO_PRICE_LABEL=¥980
# 後方互換: 旧 VITE_PRO_PAYMENT_URL を見ているコード（ProModal フォールバック）も残しているが、
# 新規には VITE_STRIPE_PAYMENT_URL を使用
VITE_PRO_PAYMENT_URL=
